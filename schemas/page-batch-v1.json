{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwiki:page-batch:1",
  "title": "Guarded coupled page updates",
  "description": "Each Markdown proposal requires a valid page envelope. Existing pages require their observed if_match hash. One recoverable changeset; filesystem updates are sequential.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "markdown": {
            "type": "string"
          },
          "if_match": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^blake3:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "markdown"
        ],
        "additionalProperties": false
      }
    },
    "read_preconditions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "absent"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "hash"
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^blake3:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "state",
                  "hash"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "path",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "pages"
  ],
  "additionalProperties": false
}
