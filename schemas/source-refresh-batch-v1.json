{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guarded existing Source refresh batch",
  "description": "At most 1 MiB JSON and 4 MiB aggregate original input bytes. Relative member files resolve from the request directory. Every member requires an observed Source-envelope hash, current Revision and exact input-byte hash. Dry-run leaves selected identity/head/reuse checks unresolved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "file",
          "if_match",
          "expected_revision",
          "input_hash"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "if_match": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "input_hash": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 4096
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      }
    }
  }
}
