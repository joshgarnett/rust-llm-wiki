{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwiki:entity-decisions:1",
  "$comment": "Production validates duplicate-free bounded UTF-8 JSON, exact canonical hashes, exhaustive remaps and immutable trace. Explicit receipts authorize only their verified operations; schema validation grants no mutation or identity authority.",
  "$ref": "#/$defs/EntityDecisionRequest",
  "$defs": {
    "EntityDecisionRequest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "lwiki.entity-decisions.v1"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityDecision"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "decisions"
      ],
      "additionalProperties": false
    },
    "EntityDecision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "MergeEntities"
            },
            "reason": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "expected_records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ExpectedRecord"
              },
              "maxItems": 4096
            },
            "remaps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntityRemap"
              },
              "maxItems": 1024
            },
            "source_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RecordId"
              },
              "maxItems": 16,
              "minItems": 1,
              "uniqueItems": true
            },
            "target_id": {
              "$ref": "#/$defs/RecordId"
            }
          },
          "required": [
            "operation",
            "reason",
            "expected_records",
            "remaps",
            "source_ids",
            "target_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "SplitEntity"
            },
            "reason": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "expected_records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ExpectedRecord"
              },
              "maxItems": 4096
            },
            "remaps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntityRemap"
              },
              "maxItems": 1024
            },
            "source_id": {
              "$ref": "#/$defs/RecordId"
            },
            "new_entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NewEntity"
              },
              "maxItems": 16,
              "minItems": 2
            }
          },
          "required": [
            "operation",
            "reason",
            "expected_records",
            "remaps",
            "source_id",
            "new_entities"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "AddAlias"
            },
            "reason": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "expected_records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ExpectedRecord"
              },
              "maxItems": 4096
            },
            "remaps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntityRemap"
              },
              "maxItems": 0
            },
            "entity_id": {
              "$ref": "#/$defs/RecordId"
            },
            "alias": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            }
          },
          "required": [
            "operation",
            "reason",
            "expected_records",
            "remaps",
            "entity_id",
            "alias"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ExpectedRecord": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "hash": {
          "$ref": "#/$defs/Blake3Hash"
        }
      },
      "required": [
        "record_id",
        "hash"
      ],
      "additionalProperties": false
    },
    "RecordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "Blake3Hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "EntityRemap": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Assertion"
            },
            "assertion_id": {
              "$ref": "#/$defs/RecordId"
            },
            "field": {
              "$ref": "#/$defs/AssertionEntityField"
            },
            "old_entity_id": {
              "$ref": "#/$defs/RecordId"
            },
            "target": {
              "$ref": "#/$defs/RemapTarget"
            }
          },
          "required": [
            "kind",
            "assertion_id",
            "field",
            "old_entity_id",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Mention"
            },
            "extraction_id": {
              "$ref": "#/$defs/RecordId"
            },
            "mention_id": {
              "$ref": "#/$defs/PacketLocalId"
            },
            "old_entity_id": {
              "$ref": "#/$defs/RecordId"
            },
            "target": {
              "$ref": "#/$defs/RemapTarget"
            }
          },
          "required": [
            "kind",
            "extraction_id",
            "mention_id",
            "old_entity_id",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AssertionEntityField": {
      "enum": [
        "subject_id",
        "object_id"
      ]
    },
    "RemapTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ExistingEntity"
            },
            "entity_id": {
              "$ref": "#/$defs/RecordId"
            }
          },
          "required": [
            "kind",
            "entity_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NewEntity"
            },
            "key": {
              "$ref": "#/$defs/NewEntityKey"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "NewEntityKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "PacketLocalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "NewEntity": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/NewEntityKey"
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "person",
            "organization",
            "project",
            "component",
            "concept",
            "place",
            "event",
            "other"
          ]
        }
      },
      "required": [
        "key",
        "title",
        "entity_type"
      ],
      "additionalProperties": false
    }
  }
}
