{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwiki:output:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "meta": {
      "type": "object",
      "properties": {
        "wiki_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freshness": {
          "enum": [
            null,
            "verified_snapshot",
            "indexed_evidence",
            "index_snapshot"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "network_used": {
          "type": "boolean"
        },
        "maintenance": {
          "type": "object",
          "description": "Optional joined maintenance metrics. Worker service intervals can overlap and are not command elapsed time.",
          "properties": {
            "submitted": {
              "type": "integer",
              "minimum": 0
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "panicked": {
              "type": "integer",
              "minimum": 0
            },
            "max_active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "max_in_flight_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "worker_service_ns": {
              "type": "integer",
              "minimum": 0
            },
            "joined_batch_wall_ns": {
              "type": "integer",
              "minimum": 0
            },
            "owner_activation_validations": {
              "type": "integer",
              "minimum": 0
            },
            "owner_activation_reads": {
              "type": "integer",
              "minimum": 0
            },
            "owner_activation_read_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "submitted",
            "completed",
            "failed",
            "panicked",
            "max_active",
            "max_in_flight_bytes",
            "worker_service_ns",
            "joined_batch_wall_ns",
            "owner_activation_validations",
            "owner_activation_reads",
            "owner_activation_read_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "wiki_id",
        "index_generation",
        "freshness",
        "verified_at",
        "partial",
        "network_used"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {}
      },
      "required": [
        "code",
        "message",
        "retryable",
        "hint",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "data",
    "meta",
    "warnings",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
