      },
      "maxItems": 20,
      "type": "array"
    },
    "reason": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "urls": {
      "items": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 60,
      "type": "array"
    }
  },
  "required": [
    "queries",
    "urls",
    "reason"
  ],
  "type": "object"
}
