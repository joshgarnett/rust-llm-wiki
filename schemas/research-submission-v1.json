{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lwiki.dev/schemas/research-submission-v1.json",
  "title": "lwiki research-submission v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "lwiki.research-submission.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "packet_fingerprint": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "stage": {
              "const": "collect_sources"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "origin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  "provenance": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 2048
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "key",
                  "title",
                  "origin",
                  "content"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 32
            }
          },
          "required": [
            "stage",
            "sources",
            "gaps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "stage": {
              "const": "answer"
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "passage_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16
                    },
                    "maxItems": 16,
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "text",
                  "passage_ids"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 32
            },
            "follow_up": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "stage",
            "claims",
            "gaps"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "run_id",
    "packet_fingerprint",
    "response"
  ],
  "additionalProperties": false
}
